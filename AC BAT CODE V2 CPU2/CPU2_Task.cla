//
// Task 8
//
__interrupt void Cla1Task8 ( void )
{
    TaskCpu2Cla1_task8++;
    loopCounter1 = 0;
    loopCounter2 = 0;
#if(TPC_MODE_RUN == CFDAB_MODE)

    PeriodMax = 2000;
    RC_INT_MACRO(rc_Duty);
    rc_Duty.StepRampDec = 0.000064f/1.0f;
    rc_Duty.StepRampInc = 0.000064f/1.0f;

#if (BUILDLEVEL == LEVEL5)

    RC_INT_MACRO(rc_VdcRef)
//    rc_VdcRef.StepRampDec = 0.0001/Udc_max;
//    rc_VdcRef.StepRampInc = 0.0001/Udc_max;
//    rc_VdcRef.StepRampDec = 0.0001/Udc_max;
//    rc_VdcRef.StepRampInc = 0.0001/Udc_max;
    rc_VdcRef.StepRampDec = 0.0001f/Udc_max*3.0f*2.5f;
    rc_VdcRef.StepRampInc = 0.0001f/Udc_max*3.0f*2.5f;


    // 0.256(s)
    RC_INT_MACRO(rc_VcRef)
//    rc_VcRef.StepRampDec = 0.001/Udc_max*3.0;
//    rc_VcRef.StepRampInc = 0.001/Udc_max*3.0;
    rc_VcRef.StepRampDec = 0.001f/Udc_max*3.0f*2.0f;
    rc_VcRef.StepRampInc = 0.001f/Udc_max*3.0f*2.0f;

    // note: 20V : 0.005, phi 500
    //       40V : 0.005, phi 500
    //       60V : 0.006, phi 1000
    //       80V : 0.007, phi 1500
    //       100V: 0.008, phi 2000
    //       120V: 0.009, phi 2500
    //       144V: 0.011, phi 3500
    //================================================================
    // PID - Lead lag
    CNTL_2P2Z_CLA_COEFFS_init(cntl_2p2z_coeff_Udc);
    cntl_2p2z_coeff_Udc.Coeff_B0 = 0.01539f/3.0f;
    cntl_2p2z_coeff_Udc.Coeff_B1 = - 0.02538f/3.0f;
    cntl_2p2z_coeff_Udc.Coeff_B2 = 0.01005f/3.0f;
    cntl_2p2z_coeff_Udc.Coeff_A1 = - 1.856f;
    cntl_2p2z_coeff_Udc.Coeff_A2 = 0.8562f;
    cntl_2p2z_coeff_Udc.Max = 0.4f;
    cntl_2p2z_coeff_Udc.Min = -0.4f;
    cntl_2p2z_coeff_Udc.IN_MAX = Udc_max;
    cntl_2p2z_coeff_Udc.OUT_MAX = 1.0f;

    CNTL_2P2Z_CLA_VARS_init(cntl_2p2z_var_Udc);


    // Voltage controller PIUDC_L
    PI_NORMAL_INT(pi_volt_Udc)
    pi_volt_Udc.Ts = T;
    pi_volt_Udc.Kp = KP_VOLT_UDC_LOOP;
    pi_volt_Udc.Ki = KI_VOLT_UDC_LOOP;
    pi_volt_Udc.LimitMax  = 0.4f;
    pi_volt_Udc.LimitMin  = -0.2f;
    pi_volt_Udc.IN_max   = Udc_max;
    pi_volt_Udc.OUT_max  = 1.0f;

    Kp_volt_Udc_test = KP_VOLT_UDC_LOOP;
    Ki_volt_Udc_test = KI_VOLT_UDC_LOOP;

    CNTL_2P2Z_CLA_COEFFS_init(cntl_2p2z_coeff_Vc);
    cntl_2p2z_coeff_Vc.Coeff_B0 = KP_VOLT_VC_LOOP+KI_VOLT_VC_LOOP+KD_VOLT_VC_LOOP;
    cntl_2p2z_coeff_Vc.Coeff_B1 = -KP_VOLT_VC_LOOP+KI_VOLT_VC_LOOP -2*KP_VOLT_VC_LOOP;
    cntl_2p2z_coeff_Vc.Coeff_B2 =  KD_VOLT_VC_LOOP;
    cntl_2p2z_coeff_Vc.Coeff_A1 = -1.0f;
    cntl_2p2z_coeff_Vc.Coeff_A2 = 0;
    cntl_2p2z_coeff_Vc.Max = 0.75f;
    cntl_2p2z_coeff_Vc.Min = 0.005f;
    cntl_2p2z_coeff_Vc.IN_MAX = Udc_max;
    cntl_2p2z_coeff_Vc.OUT_MAX = 1.0f;
    CNTL_2P2Z_CLA_VARS_init(cntl_2p2z_var_Vc);
#endif

    LOWPASSFILTER_INT(filter_Udc_CFDAB)
    LOWPASSFILTER_INT(filter_Ubat)
    LOWPASSFILTER_INT(filter_Vc)
    LOWPASSFILTER_INT(filter_Ilv)

    BANDSTOP_FILTER_INT(filterBand_Udc_CFDAB);
    BANDSTOP_FILTER_INT(filterBand_Vc);

    // Band Stop filter
    // fc = 100Hz
    filterBand_Udc_CFDAB.w0 = 2*PI*100;
    filterBand_Udc_CFDAB.wc = 2*PI*100;
    filterBand_Udc_CFDAB.Ts = T;
    BANDSTOP_FILTER_PARA(filterBand_Udc_CFDAB);

    // fc = 100Hz
    filterBand_Vc.w0 = 2*PI*100;
    filterBand_Vc.wc = 2*PI*100;
    filterBand_Vc.Ts = T;
    BANDSTOP_FILTER_PARA(filterBand_Vc);

    // fc = 1000Hz
    filter_Udc_CFDAB_pre.Heso_out = 1.0f/(1.0f + T*2*PI*1000);
    filter_Udc_CFDAB_pre.Heso_in = 1.0f - filter_Udc_CFDAB_pre.Heso_out;

    filter_Vc_pre.Heso_out = 1.0f/(1.0f + T*2*PI*1000);
    filter_Vc_pre.Heso_in = 1.0f - filter_Vc_pre.Heso_out;

    //---------------------------------------------
    // Low pass filter
    // fc = 100Hz
    filter_Udc_CFDAB.Heso_out = 1.0f/(1.0f + T*2*PI*500);
    filter_Udc_CFDAB.Heso_in = 1.0f - filter_Udc_CFDAB.Heso_out;

    filter_Vc.Heso_out = 1.0f/(1.0f + T*2*PI*500);
    filter_Vc.Heso_in = 1.0f - filter_Vc.Heso_out;

    // fc = 100Hz
    filter_Ubat.Heso_out = 1.0f/(1.0f + T*2*PI*100);
    filter_Ubat.Heso_in = 1.0f - filter_Ubat.Heso_out;

    filter_Ilv.Heso_out = 1.0f/(1.0f + T*2*PI*100);
    filter_Ilv.Heso_in = 1.0f - filter_Ilv.Heso_out;

    // Khoi tao cac bien
    i = 0 ;
    OffsetCalCounter = 0;
    IsrTickerTask1 = 0;
    ResetOffset = 1;
//    IsrTickerTask1 = 0;
//    IsrTickerTask2 = 0;

    START_ADC = 2;
    start_duty = 0;

    Cnt_filter = 0;
    Cnt_duty = 0;
    Cnt_phi = 0;
    Cnt_Enablephi = 0;
    Flag_duty = 0;
    Flag_phi = 0;
    Enable_duty = 0;
    Enable_phi = 0;
    Enable_filter = 0;
    Switch_control = 0;
    switch_bdk = 0;
    switch_timectl = 0;

    Cmpa_Q1 = 0;
    Cmpa_Q2 = 0;
    Cmpa_S1 = 0;
    Cmpa_S4 = 0;
    Cmpb_S4 = 0;

    Duty = 0.64;
    detaPhi = 8.0f/360.0f;
    theta1 = 0;
    theta2 = (2.0f*Duty - 1 - 2*detaPhi)/2.0f;

#endif

#if(TPC_MODE_RUN == VFDAB_MODE)

    i = 0 ;

    //PeriodMax = (Frequency_Clock_PWM/(2*Isr_Frequency)); /* Initializa ePWM */
    //PeriodMax = 1000; //50khz
     PeriodMax = 500; //100khz
    //PeriodMax = 625; //80khz
    //PeriodMax = 715; //70khz
    //PeriodMax = 834; //60khz
    //================================================================
    // RAMP = (3.125(s))
    RC_INT_MACRO(rc_Duty)
    //rc_Duty.StepRampDec = 0.0000064/DUTY_MAX;    // y = kx + b, k = tan = 0.000064/(1/50000), y = 0.5, b =0 => x = 3.125s
    //rc_Duty.StepRampInc = 0.0000064/DUTY_MAX;
    rc_Duty.StepRampDec = 0.0000064f/DUTY_MAX;//0.0000084    // y = kx + b, k = tan = 0.000064/(1/50000), y = 0.5, b =0 => x = 3.125s
    rc_Duty.StepRampInc = 0.0000064f/DUTY_MAX;
#if (BUILDLEVEL == LEVEL3)
    // RAMP = (0.2(s))
//    RC_INT_MACRO(rc_Duty)
//    rc_Duty.StepRampDec = 0.000064/DUTY_MAX;
//    rc_Duty.StepRampInc = 0.000064/DUTY_MAX;

    // 0.25(s)
    RC_INT_MACRO(rc_VdcRef)
    //rc_VdcRef.StepRampDec = 0.00005/Udc_max;
    //rc_VdcRef.StepRampInc = 0.00005/Udc_max;
    rc_VdcRef.StepRampDec = 0.000005f*2.0f/Udc_max; // 0.000005
    rc_VdcRef.StepRampInc = 0.000005f*2.0f/Udc_max;


    //================================================================
//    CNTL_2P2Z_CLA_COEFFS_init(cntl_2p2z_coeff_Udc);
//    cntl_2p2z_coeff_Udc.Coeff_B0 = 0.01539;
//    cntl_2p2z_coeff_Udc.Coeff_B1 = - 0.02538;
//    cntl_2p2z_coeff_Udc.Coeff_B2 = 0.01005;
//    cntl_2p2z_coeff_Udc.Coeff_A1 = - 1.856;
//    cntl_2p2z_coeff_Udc.Coeff_A2 = 0.8562;
//    cntl_2p2z_coeff_Udc.Max = 0.4;
//    cntl_2p2z_coeff_Udc.Min = 0.001;
//    cntl_2p2z_coeff_Udc.IN_MAX = Udc_max;
//    cntl_2p2z_coeff_Udc.OUT_MAX = 1.0;
//
//    CNTL_2P2Z_CLA_VARS_init(cntl_2p2z_var_Udc);
    //================================================================
    // Voltage controller
    PI_NORMAL_INT(pi_volt_Udc)
    pi_volt_Udc.Ts = T;
    pi_volt_Udc.Kp = KP_VOLT_UDC_LOOP;
    pi_volt_Udc.Ki = KI_VOLT_UDC_LOOP;
    pi_volt_Udc.LimitMax  = 0.4;
    pi_volt_Udc.LimitMin  = -0.4;
    pi_volt_Udc.IN_max   = Udc_max;
    pi_volt_Udc.OUT_max  = 1.0;


#endif
    //================================================================
    LOWPASSFILTER_INT(filter_Udc)
    LOWPASSFILTER_INT(filter_Ubat)
    LOWPASSFILTER_INT(filter_Vc)
    LOWPASSFILTER_INT(filter_Ihv)
    //LOWPASSFILTER_INT(filter_I_out)

    BANDSTOP_FILTER_INT(filterBand_Udc);
    BANDSTOP_FILTER_INT(filterBand_Vc);

    // Band Stop filter
    // fc = 100Hz
    filterBand_Udc.w0 = 2*PI*100;
    filterBand_Udc.wc = 2*PI*100;
    filterBand_Udc.Ts = T;
    BANDSTOP_FILTER_PARA(filterBand_Udc);

    // fc = 100Hz
    filterBand_Vc.w0 = 2*PI*100;
    filterBand_Vc.wc = 2*PI*100;
    filterBand_Vc.Ts = T;
    BANDSTOP_FILTER_PARA(filterBand_Vc);

    // fc = 1000Hz
    filter_Udc_pre.Heso_out = 1.0/(1.0 + T*2*PI*100);
    filter_Udc_pre.Heso_in = 1.0 - filter_Udc_pre.Heso_out;

    filter_Vc_pre.Heso_out = 1.0/(1.0 + T*2*PI*100);
    filter_Vc_pre.Heso_in = 1.0 - filter_Vc_pre.Heso_out;

    //---------------------------------------------
    // Low pass filter
    // fc = 100Hz
    filter_Udc.Heso_out = 1.0/(1.0 + T*2*PI*100);
    filter_Udc.Heso_in = 1.0 - filter_Udc.Heso_out;

    filter_Vc.Heso_out = 1.0/(1.0 + T*2*PI*100);
    filter_Vc.Heso_in = 1.0 - filter_Vc.Heso_out;

    // fc = 100Hz
    filter_Ubat.Heso_out = 1.0/(1.0 + T*2*PI*100);
    filter_Ubat.Heso_in = 1.0 - filter_Ubat.Heso_out;

    filter_Ihv.Heso_out = 1.0/(1.0 + T*2*PI*100);
    filter_Ihv.Heso_in = 1.0 - filter_Ihv.Heso_out;

   //filter_I_out.Heso_out = 1.0/(1.0 + T*2*PI*100);
   //filter_I_out.Heso_in = 1.0 - filter_I_out.Heso_out;
    //================================================================================================
    // Khoi tao cac bien
    i = 0 ;
    OffsetCalCounter = 0;
    ResetOffset = 1;
    IsrTickerTask1 = 0;
    TaskCpu2Cla1 = 0;
    TaskCpu2Cla1_task8 = 0;
    START_ADC = 2;

    start_duty = 0;

    //---------------------------------------------------
    Cnt_filter = 0;
    Cnt_duty = 0;
    Cnt_phi = 0;
    Flag_duty = 0;
    Flag_phi = 0;
    Flag_Enable = 0;
    Enable_duty = 0;
    Enable_phi = 0;
    Enable_filter = 0;
    Enable = 0;
    a = 0;
    b = 0;
    switch_bdk = 0;

    //---------------------------------------------------
    Cmpa_Q1 = 0;
    Cmpa_Q2 = 0;
    Cmpa_S1 = 0;
    Cmpa_S4 = 0;
    Cmpb_S4 = 0;
    c = 0;

    //---------------------------------------------------
    Duty = 0;
    theta1 = 0.000f;    // theta1 = Phase(deg)/180; 30deg : 0.1666666666667


    /**********************************************************/
//    __mnop();
//    __mnop();
//    __mnop();
#endif
}

