            Phase_S4 = (int16)(PeriodMax - ((int16)(theta1*PeriodMax) + PeriodMax/2));

            if((Phase_S1 - PeriodMax ) >= 0) Phase_S1 = Phase_S1 - PeriodMax;
            else if(Phase_S1 <= 0)Phase_S1 = Phase_S1 + PeriodMax;

