                            {   Enable = 1;
                                Flag_Enable = 1;
                                a = adc_filter.Udc*800.0f;
                                b = rc_Duty.SetpointValue;
                            }
                        }

                        if(Cnt_duty == 1) Enable_duty = 1;   // 0 (s)
                        if(Cnt_phi == 300000 || Enable == 1) Enable_phi = 1; // 6(s)

                        //*************************************************************//
                        if(Enable_duty == 1)
                        {
                            if(Enable == 0)
                            {
                            if(Flag_duty == 0)
                               {
                           // rc_Duty.SetpointValue = CpuToCLA.DutyStart;
                                rc_Duty.SetpointValue = 0.001f;
                            Flag_duty = 1;
                //            pi_volt_Udc.REF = CpuToCLA.UdcThreshold;
                               }
                            rc_Duty.TargetValue = CpuToCLA.DutyTesting_Discharge;
                            RC_CLA_MACRO(rc_Duty)
                            } else rc_Duty.SetpointValue = CpuToCLA.DutyTesting_Discharge;

                            EPwm7Regs.DBCTL.bit.OUT_MODE    = 3;    // Enabled Dead Band
                            EPwm8Regs.DBCTL.bit.OUT_MODE    = 3;    // Enabled Dead Band

                            EPwm7Regs.CMPA.bit.CMPA =(Uint16)(rc_Duty.SetpointValue*PeriodMax);
                            EPwm7Regs.CMPB.bit.CMPB =(Uint16)(PeriodMax-rc_Duty.SetpointValue*PeriodMax);
                            EPwm8Regs.CMPA.bit.CMPA =(Uint16)(rc_Duty.SetpointValue*PeriodMax);
                            EPwm8Regs.CMPB.bit.CMPB =(Uint16)(PeriodMax-rc_Duty.SetpointValue*PeriodMax);
                        }

                        if(Enable_phi == 1)
                        {
                            if(Enable == 0)
                            {
                            if(Flag_phi == 0)
                            {
                                rc_VdcRef.SetpointValue = adc_filter.Udc;
                                Flag_phi = 1;
                            }
                            //rc_VdcRef.TargetValue = CpuToCLA.UdcRef;
                            rc_VdcRef.TargetValue = 400.0f/800.0f;
                            RC_CLA_MACRO(rc_VdcRef)
                            } //else rc_VdcRef.SetpointValue = CpuToCLA.UdcRef;
                            else rc_VdcRef.SetpointValue = 400.0f/800.0f;

                            //Thay doi bo dieu khien khi switch_bdk = 1
                            #if(SWITCH_BDK_MODE == ALLOW_SWITCH_BDK)
                                if(switch_bdk == 1)
                                {
                                    pi_volt_Udc.Kp = KP_VOLT_UDC_LOOP_1;
                                    pi_volt_Udc.Ki = KI_VOLT_UDC_LOOP_1;
                                }
                                else if(switch_bdk == 0)
                                {
                                    pi_volt_Udc.Kp = KP_VOLT_UDC_LOOP;
                                    pi_volt_Udc.Ki = KI_VOLT_UDC_LOOP;
                                }
                            #endif

                            // PI controller
                            pi_volt_Udc.REF = rc_VdcRef.SetpointValue;

                            pi_volt_Udc.INPUT = adc_filter.Udc;

                            pi_volt_Udc.ERROR = pi_volt_Udc.REF - pi_volt_Udc.INPUT;
                            PI_NORMAL_V2_MACRO(pi_volt_Udc)

                        }

                        theta1 = pi_volt_Udc.OUT;

                        //-----------------------------------------------------
                        // Phase
                        Phase_S1 = (int16)(PeriodMax/2.0f - ((int16)(theta1*PeriodMax)));
                        Phase_S4 = (int16)(PeriodMax/2.0f - ((int16)(theta1*PeriodMax)));
                        //-----------------------------------------------------
                        EPwm9Regs.TBPHS.bit.TBPHS = Phase_S1;
                        EPwm10Regs.TBPHS.bit.TBPHS = Phase_S4;
                        //*************************************************************//


                        if(Enable_phi == 1)
                        {
                            EPwm7Regs.CMPC = 250;
                            EPwm9Regs.DBCTL.bit.OUT_MODE    = 3;    // Enabled Dead Band
                            EPwm10Regs.DBCTL.bit.OUT_MODE    = 3;    // Enabled Dead Band

                            EPwm9Regs.CMPA.bit.CMPA =(0.5f*PeriodMax);
                            EPwm10Regs.CMPA.bit.CMPA =(0.5f*PeriodMax);
                        }

                #endif
            }
        else
        {
            //   Ngat phat xung PWM

            EPwm7Regs.DBCTL.bit.OUT_MODE    = 0;    // Disabled Dead Band
            EPwm8Regs.DBCTL.bit.OUT_MODE    = 0;    // Disabled Dead Band
            //EPwm3Regs.DBCTL.bit.OUT_MODE    = 0;    // Disabled Dead Band
            //EPwm4Regs.DBCTL.bit.OUT_MODE    = 0;    // Disabled Dead Band
            EPwm9Regs.DBCTL.bit.OUT_MODE    = 0;    // Disabled Dead Band
            EPwm10Regs.DBCTL.bit.OUT_MODE    = 0;    // Disabled Dead Band

            EPwm7Regs.CMPA.bit.CMPA = 0;                // Set compare A value : PWM1A -> muc 0
            EPwm7Regs.CMPB.bit.CMPB = 0;                // Set Compare B value : PWM1B -> muc 0

            EPwm8Regs.CMPA.bit.CMPA = 0;                // Set compare A value 0
            EPwm8Regs.CMPB.bit.CMPB = 0;                // Set Compare B value 0

            EPwm9Regs.CMPA.bit.CMPA = PeriodMax;        // Set compare A value : PWM1A -> muc 0
            EPwm9Regs.CMPB.bit.CMPB = PeriodMax;        // Set Compare B value : PWM1B -> muc 0

            EPwm10Regs.CMPA.bit.CMPA = 0;                // Set compare A value 0
            EPwm10Regs.CMPB.bit.CMPB = PeriodMax;                // Set Compare B value 0

            EPwm9Regs.TBPHS.bit.TBPHS = PeriodMax/2.0f;
            EPwm10Regs.TBPHS.bit.TBPHS = PeriodMax/2.0f;



            start_duty = 0;
            Cnt_duty = 0;
            Cnt_phi = 0;
            Flag_duty = 0;
            Flag_phi = 0;
            Flag_Enable = 0;
            Enable_duty = 0;
            Enable_phi = 0;
            Enable_filter = 0;
            Enable = 0;
            a = 0;
            b = 0;
            c = 0;
            switch_bdk = 0;

        }


#endif
    // SDFM source file

    Uint32 sdfmReadFlagRegister;

    //
    // Read SDIFLG of SDFM1
    //
//    sdfmReadFlagRegister = Sdfm1Regs.SDIFLG.all;

    //
    // Reset the loop counter
    //
//    if(loopCounter1 >= MAX_SAMPLES)
//    {
//        loopCounter1 = 0;
//    }

    //
    // Read 16-bit result from SDFM1 filter1-4 data registers & store in
    // result arrays
    //
//    Filter1_Result_CPU2[loopCounter1] = *(Uint16 *)((Uint16)0x5E17);
//    Filter2_Result_CPU2[loopCounter1] = *(Uint16 *)((Uint16)0x5E27);
//    Filter3_Result_CPU2[loopCounter1] = *(Uint16 *)((Uint16)0x5E37);
//    Filter4_Result_CPU2[loopCounter1++] = *(Uint16 *)((Uint16)0x5E47);

    //
    // Clear SDFM1.SDIFLG register
    //
//    Sdfm1Regs.SDIFLGCLR.all = sdfmReadFlagRegister;
}

