            ClaToCPU.ADC_CPU.Udc_CFDAB = adc_filter.Udc_CFDAB;
            ClaToCPU.ADC_CPU.Vc        = adc_filter.Vc;
            ClaToCPU.ADC_CPU.Ubat      = adc_filter.Ubat;
            ClaToCPU.ADC_CPU.Ilv       = adc_filter.Ilv;

