        pi_curr_iq.Kp = KP_CURR_LOOP;
        pi_curr_iq.Ki = KI_CURR_LOOP;
        pi_curr_iq.IN_max   = 10.0f;
        pi_curr_iq.OUT_max  = 400.0f;

        PI_NORMAL_INT(pi_curr_iz)
