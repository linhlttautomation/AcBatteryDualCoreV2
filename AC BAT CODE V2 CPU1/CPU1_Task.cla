        pi_curr_iz.Kp = KP_CURR_LOOP_Z;
        pi_curr_iz.Ki = KI_CURR_LOOP_Z;
        pi_curr_iz.IN_max   = 10.0f;
        pi_curr_iz.OUT_max  = 400.0f;

    #endif

    #if(BUILDLEVEL == LEVEL4)

        loop_volt_Us = 0;

        // Current controller
